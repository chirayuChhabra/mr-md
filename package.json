{
  "name": "mr-md",
  "version": "4.0.0-alpha.1",
  "description": "Mr Markdown is an opinionated Markdown framework for building interactive learning pages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mr-md": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepublishOnly": "bun run build",
    "dev:docs": "bun dist/cli.js dev mr-markdown-documentation",
    "build:docs": "bun dist/cli.js build mr-markdown-documentation",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun run build && bun run build:docs && bun test --timeout 60000 && bun run typecheck",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "keywords": [
    "markdown",
    "blog",
    "interactive",
    "education",
    "shiki",
    "katex",
    "course"
  ],
  "author": "Chirayu Chhabra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chirayuChhabra/mr-md.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@biomejs/cli-darwin-arm64": "2.6.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "puppeteer": "^25.16.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "boxen": "^9.0.0",
    "consola": "^3.4.2",
    "isomorphic-dompurify": "^4.6.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "prismjs": "^1.30.0",
    "shiki": "^4.5.0",
    "tinyclip": "^1.0.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "undici": "^7.28.0"
  },
  "resolutions": {
    "undici": "^7.28.0"
  }
}
