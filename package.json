{
  "name": "mr-md",
  "version": "3.1.1",
  "description": "Mr Markdown is an opinionated Markdown framework for building interactive learning pages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mr-md": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepublishOnly": "bun run build",
    "dev:docs": "bun dist/cli.js dev mr-markdown-documentation",
    "build:docs": "bun dist/cli.js build mr-markdown-documentation",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun run build && bun test --timeout 60000 && bun run typecheck",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "keywords": [
    "markdown",
    "blog",
    "interactive",
    "education",
    "shiki",
    "katex",
    "course"
  ],
  "author": "Chirayu Chhabra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chirayuChhabra/mr-md.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@biomejs/cli-darwin-arm64": "2.5.14",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "puppeteer": "^25.12.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "boxen": "^9.0.0",
    "consola": "^3.4.2",
    "isomorphic-dompurify": "^4.3.0",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "shiki": "^4.4.3",
    "tinyclip": "^1.0.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "undici": "^7.28.0"
  },
  "resolutions": {
    "undici": "^7.28.0"
  }
}
