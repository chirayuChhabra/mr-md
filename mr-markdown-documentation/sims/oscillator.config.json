{
  "type": "block",
  "timeline": true,
  "label": "Damped Harmonic Oscillator",
  "caption": "Explore how damping changes spring–mass motion. For viscous damping, the damping ratio ζ = c_eff / (2√(km)) identifies the motion. Drag the cart to set it moving.",
  "height": 320,
  "props": {
    "damping": 1.5,
    "dampingMode": "viscous",
    "medium": "air",
    "stiffness": 25,
    "mass": 1.0
  },
  "advancedControls": [
    "dampingMode",
    "medium",
    "stiffness",
    "mass"
  ],
  "tunables": {
    "damping": {
      "label": "Damping (c)",
      "type": "range",
      "min": 0,
      "max": 25,
      "step": 0.5,
      "unit": "N·s/m"
    },
    "dampingMode": {
      "label": "Damping model",
      "type": "select",
      "options": [
        {
          "label": "Viscous",
          "value": "viscous"
        },
        {
          "label": "Quadratic Drag",
          "value": "quadratic"
        },
        {
          "label": "Dry Friction",
          "value": "friction"
        }
      ]
    },
    "medium": {
      "label": "Medium",
      "type": "select",
      "options": [
        {
          "label": "Vacuum (0.0×, c = 0)",
          "value": "vacuum"
        },
        {
          "label": "Air (1.0× drag)",
          "value": "air"
        },
        {
          "label": "Water / Light Oil (2.5×)",
          "value": "water"
        },
        {
          "label": "Viscous Glycerin (5.0×)",
          "value": "glycerin"
        }
      ]
    },
    "stiffness": {
      "label": "Spring Stiffness (k)",
      "type": "range",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "N/m"
    },
    "mass": {
      "label": "Cart Mass (m)",
      "type": "number",
      "min": 0.5,
      "max": 5.0,
      "step": 0.5,
      "unit": "kg"
    }
  },
  "actions": {
    "impulse": {
      "label": "Apply impulse",
      "color": "green"
    },
    "zero": {
      "label": "Reset to Rest",
      "color": "neutral"
    }
  },
  "presets": {
    "underdamped": {
      "label": "Underdamped",
      "props": {
        "dampingMode": "viscous",
        "medium": "air",
        "stiffness": 25,
        "damping": 1.5,
        "mass": 1.0
      }
    },
    "critical": {
      "label": "Critical Damping",
      "props": {
        "dampingMode": "viscous",
        "medium": "water",
        "stiffness": 25,
        "damping": 4.0,
        "mass": 1.0
      }
    },
    "overdamped": {
      "label": "Overdamped",
      "props": {
        "dampingMode": "viscous",
        "medium": "glycerin",
        "stiffness": 25,
        "damping": 5.0,
        "mass": 1.0
      }
    },
    "undamped": {
      "label": "Pure Undamped",
      "props": {
        "dampingMode": "viscous",
        "medium": "vacuum",
        "stiffness": 25,
        "damping": 0.0,
        "mass": 1.0
      }
    }
  },
  "telemetry": {
    "regime": {
      "label": "Damping regime",
      "display": "status",
      "states": [
        {
          "when": {
            "op": "eq",
            "value": "Near critical damping"
          },
          "tone": "accent"
        }
      ]
    },
    "displacement": {
      "label": "Displacement x",
      "unit": "m",
      "precision": 3,
      "graph": true,
      "states": [
        {
          "when": {
            "op": "gt",
            "value": 0.01
          },
          "tone": "accent"
        },
        {
          "when": {
            "op": "lt",
            "value": -0.01
          },
          "tone": "accent"
        }
      ]
    },
    "velocity": {
      "label": "Velocity v",
      "unit": "m/s",
      "precision": 3,
      "graph": {
        "x": {
          "key": "displacement",
          "label": "Displacement",
          "unit": "m"
        },
        "y": {
          "label": "Velocity",
          "unit": "m/s"
        }
      },
      "states": [
        {
          "when": {
            "op": "gt",
            "value": 0.05
          },
          "tone": "accent",
          "label": "Moving right"
        },
        {
          "when": {
            "op": "lt",
            "value": -0.05
          },
          "tone": "accent",
          "label": "Moving left"
        }
      ]
    },
    "angularFrequency": {
      "label": "Natural angular frequency ω₀",
      "unit": "rad/s",
      "precision": 2
    },
    "dampingRatio": {
      "label": "Damping ratio ζ",
      "precision": 3
    }
  },
  "measurements": {
    "initialTab": "telemetry",
    "graphs": [
      {
        "key": "displacement",
        "x": 24,
        "y": 80,
        "width": 420,
        "height": 290
      }
    ],
    "timeline": true
  }
}
