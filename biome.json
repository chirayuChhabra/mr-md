{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noDescendingSpecificity": "off",
				"useNodejsImportProtocol": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"files": {
		"includes": ["src/**/*.ts", "src/**/*.js", "example/**/*.ts"]
	}
}
